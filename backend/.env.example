# PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://cv_builder:cv_builder@localhost:5432/cv_builder
PORT=4000
# development | test | production. In production the auth cookies are sent over HTTPS only.
NODE_ENV=development
# Token signing keys, 32 characters or more. These values are for local use only; make new ones for any deployed server
# (for example: openssl rand -hex 32).
JWT_ACCESS_SECRET=local-development-access-secret-change-me
JWT_REFRESH_SECRET=local-development-refresh-secret-change-me
# Rate limit on sign-in and the other public auth operations: at most THROTTLE_LIMIT calls per client IP in THROTTLE_TTL_SECONDS.
THROTTLE_LIMIT=10
THROTTLE_TTL_SECONDS=60
# Number of proxies in front of the backend. 0 locally (X-Forwarded-For is ignored). Set it in production behind a proxy,
# or every user shares the proxy's IP for the rate limit.
TRUST_PROXY_HOPS=0
# Optional. `db:seed` refuses a database that is not on localhost or 127.0.0.1 and whose name does not end in _test.
# Set it to 1 only to seed a remote demo database on purpose. NODE_ENV=production is always refused.
# SEED_ALLOW_REMOTE=1
# Optional, used by `pnpm --filter @cv-builder/backend test:int`. The name must end in _test; this is the default.
# TEST_DATABASE_URL=postgresql://cv_builder:cv_builder@localhost:5432/cv_builder_test
# Absolute links in emails (verification, password reset).
FRONTEND_URL=http://localhost:3000
# Mail. These values reach Mailpit from docker-compose.yml: the inbox is http://localhost:8025.
# SMTP_USER and SMTP_PASS stay empty for Mailpit; set both for a real SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CV Builder <no-reply@cv-builder.local>
