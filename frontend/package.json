{
  "name": "@cv-builder/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm codegen && next dev",
    "build": "pnpm codegen && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "pnpm codegen && next typegen && tsc --noEmit",
    "test": "pnpm codegen && vitest run",
    "test:cov": "pnpm codegen && vitest run --coverage",
    "test:shard": "pnpm codegen && vitest run --coverage --reporter=default --reporter=blob --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:merge": "pnpm codegen && vitest --merge-reports --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@apollo/client": "^4.3.5",
    "@apollo/client-integration-nextjs": "^0.14.5",
    "@hookform/resolvers": "^7.0.1",
    "date-fns": "^4.4.0",
    "downshift": "^9.4.0",
    "graphql": "^16.14.2",
    "next": "16.4.6",
    "next-intl": "^4.14.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-datepicker": "^9.1.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "rxjs": "^7.8.2",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typed-document-node": "^7.2.0",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
